# .streamlit/secrets.toml
# ─────────────────────────────────────────────────────────────────────────────
# Streamlit Community Cloud secrets file.
# NEVER commit the real values to git — add .streamlit/secrets.toml to .gitignore
#
# For local development:  place this file at lcri-dashboard/.streamlit/secrets.toml
# For Streamlit Cloud:    paste the keys into the app's Secrets manager in the UI.
# ─────────────────────────────────────────────────────────────────────────────

# ESRI Living Atlas / ArcGIS API key
# Obtain from: https://developers.arcgis.com/dashboard/
# Required for live zonal stats queries against the image service.
# If absent, the app falls back to pre-cached results from data/cache/
[esri]
api_key = "REPLACE_WITH_YOUR_ARCGIS_API_KEY"

# Google Earth Engine service account (supplementary layers only)
# Source: ee-petersonyang87-52f0e0a9ad78.json in your workspace
# Paste the entire JSON content as a multi-line TOML string.
[earthengine]
service_account = "REPLACE_WITH_EE_SERVICE_ACCOUNT_EMAIL"
private_key     = "REPLACE_WITH_EE_PRIVATE_KEY"
